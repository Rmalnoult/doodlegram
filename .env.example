# ===========================================
# Doodlegram — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- local PostgreSQL (required) ---
# Local dev: get these from `supabase start` output
# Production: get from local PostgreSQL Dashboard > Settings > API
DATABASE_URL=http://localhost:54321
# Removed

# --- DeepSeek API (required, server-only) ---
# Get from https://platform.deepseek.com/api_keys. Both SDK clients use it:
# the Anthropic one and the OpenAI one, each on its compatible endpoint.
DEEPSEEK_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com/anthropic
# AI_OPENAI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash

# --- fal.ai (required, server-only) ---
# Get from https://fal.ai/dashboard/keys
FAL_KEY=...

# --- App URL (optional) ---
# Used for canonical URLs and OG meta tags
# Set to your production domain when deploying
NUXT_PUBLIC_APP_URL=http://localhost:3000
